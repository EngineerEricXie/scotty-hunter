# ScottyBites local demo does not require any of these.
# Leave them blank. Never paste real secrets into git.

# Demo (defaults are already safe for judging)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_DATE=2026-09-12
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional LLM extraction — EXTRACTION_PROVIDER=llm plus one key
EXTRACTION_PROVIDER=heuristic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Google Calendar OAuth (manual authorization required)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Optional map tokens if you replace OpenFreeMap
MAPBOX_TOKEN=
MAPTILER_API_KEY=

# Optional Playwright for JS-heavy public pages
PLAYWRIGHT_FETCH=false
